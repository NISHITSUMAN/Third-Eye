# Public browser configuration. Values with VITE_ are included in the
# client bundle and must never contain private credentials.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
VITE_PROJECT_REPOSITORY_URL=https://github.com/NISHITSUMAN/Third-Eye

# Optional Cesium configuration. Keep all values public/non-secret.
VITE_CESIUM_ION_TOKEN=
VITE_CESIUM_ION_IMAGERY_ASSET_ID=2
VITE_CESIUM_TERRAIN=false

# Server-only variables for the TanStack Start API routes.
# Set these in Vercel Project Settings -> Environment Variables and in
# the local server process. NEVER rename these with a VITE_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GUEST_RATE_LIMIT_SALT=

# Server-side Groq assistant configuration.
GROQ_API_KEY=
GROQ_MODEL=

# NASA Earthdata credentials belong to the Python science-worker process,
# not to browser code. Configure them in the worker's own EnvironmentFile.
# Use EARTHDATA_TOKEN, OR use both username and password.
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
