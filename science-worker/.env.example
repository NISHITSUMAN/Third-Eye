# Supabase worker connection (server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
PORT=8000
SCIENCE_WORKER_POLL_SECONDS=3
LOG_LEVEL=info

# NASA Earthdata Login — required only for NISAR raster retrieval
# Prefer EARTHDATA_TOKEN; otherwise set both username and password.
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
